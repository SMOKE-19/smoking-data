{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smoking-data.source.v5",
  "title": "Smoking Data Source 0101 v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["yaml", "job", "source", "output"],
  "properties": {
    "yaml": {
      "type": "object",
      "description": "YAML Definition 식별 정보",
      "additionalProperties": false,
      "required": ["schema_version", "asset_code"],
      "properties": {
        "schema_version": {"const": "smoking-data.source.v5", "description": "0101 Source YAML 공개 계약 버전"},
        "asset_code": {"const": "0101", "description": "Source Asset 코드"}
      }
    },
    "job": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}, "description": {"type": "string"}}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_request"],
      "properties": {
        "table_id": {"type": "string", "minLength": 1},
        "api_request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["query_mode"],
          "properties": {
            "query_mode": {"type": "string", "enum": ["structured", "sql_file", "http_json", "http_ndjson", "http_xml"]},
            "http": {"$ref": "#/$defs/httpRequest"},
            "adapter": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "default": "spi", "description": "설치된 SOURCE adapter entry point 식별자"},
            "adapter_options": {"type": "object", "additionalProperties": true, "description": "선택한 adapter에 전달할 불투명 실행 옵션"},
            "spi": {"type": "object", "additionalProperties": true, "description": "구버전 호환용 adapter 옵션 별칭. 신규 Definition에서는 adapter_options를 사용"},
            "sql": {
              "type": "object",
              "description": "SQL build에 필요한 0101 전체 명세. select 항목 순서와 name/expr 순서를 보존합니다.",
              "additionalProperties": false,
              "required": ["table_id", "date_window"],
              "properties": {
                "table_id": {"type": "string", "minLength": 1},
                "select": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name"],
                    "properties": {
                      "name": {"type": "string", "minLength": 1},
                      "expr": {"type": "string", "minLength": 1}
                    }
                  }
                },
                "filters": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "common": {"type": "array", "items": {"type": "string"}},
                    "sub_job": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["sub_job_name", "sub_job_filtering"],
                        "properties": {
                          "sub_job_name": {"type": "string", "minLength": 1},
                          "sub_job_filtering": {"type": "array", "items": {"type": "string"}}
                        }
                      }
                    }
                  }
                },
                "sql_file_path": {"type": "string", "minLength": 1},
                "date_window": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["step", "date_window"],
                  "properties": {
                    "column": {"type": "string", "minLength": 1},
                    "step": {"type": "number", "exclusiveMinimum": 0},
                    "date_window": {"type": "array", "minItems": 1, "items": {"type": "string"}}
                  }
                }
              }
            },
            "payload": {
              "type": "object",
              "description": "structured query의 select와 canonical filters",
              "additionalProperties": false,
              "properties": {
                "select": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name"],
                    "properties": {
                      "name": {"type": "string", "minLength": 1},
                      "expr": {"type": "string", "minLength": 1}
                    }
                  }
                },
                "filters": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "common": {"type": "array", "items": {"type": "string"}},
                    "sub_job": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["sub_job_name", "sub_job_filtering"],
                        "properties": {
                          "sub_job_name": {"type": "string", "minLength": 1},
                          "sub_job_filtering": {
                            "type": "array",
                            "items": {"type": "string"}
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "sql_file_path": {"type": "string", "minLength": 1},
            "date_window": {
              "type": "object",
              "additionalProperties": false,
              "required": ["step", "date_window"],
              "properties": {
                "column": {"type": "string", "minLength": 1},
                "step": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Window duration in days. Fractional days are truncated to whole seconds at runtime."
                },
                "date_window": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "description": "실행·retry·print capture 설정",
      "additionalProperties": false,
      "properties": {
        "reset_before_run": {"type": "boolean"},
        "write_source_profile_json": {"type": "boolean"},
        "retryable_error_substrings": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "workers": {"type": "integer", "minimum": 1},
        "warmup_first_task": {"type": "boolean"},
        "worker_start_delay_sec": {"type": "number", "minimum": 0},
        "max_retries": {"type": "integer", "minimum": 0},
        "retry_backoff_sec": {"type": "number", "minimum": 0},
        "test_run": {
          "type": "object",
          "description": "전체 task를 계획한 뒤 최종 source extraction task만 제한해서 실행하는 테스트 모드",
          "additionalProperties": false,
          "required": ["final_task_limit"],
          "properties": {
            "final_task_limit": {"type": "integer", "minimum": 1, "default": 1}
          }
        },
        "data_api_print_capture": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rules": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["field"],
                    "properties": {
                      "field": {"type": "string", "minLength": 1},
                      "enabled": {"type": "boolean"},
                      "capture": {"type": "string", "enum": ["regex", "full_text"]},
                      "regex": {"type": "string", "minLength": 1}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {"const": "source_dataset"},
            "root_dir": {"type": "string", "minLength": 1},
            "format": {"const": "parquet"},
            "compression": {"type": "string", "enum": ["snappy", "zstd", "uncompressed"], "default": "zstd"},
            "physical_layout": {"$ref": "#/$defs/physicalLayout"},
            "file_name_rule": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "raw_dataset": {"type": "string", "minLength": 1}
              }
            },
            "parquet_writer": {"$ref": "#/$defs/parquetWriter"},
            "publication": {"$ref": "publication-v1.schema.json#/$defs/publicationOverride"}
          }
        },
        "logging": {"$ref": "#/$defs/loggingOutput"}
      }
    }
  },
  "$defs": {
    "httpRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "pattern": "^https?://"},
        "query": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "headers": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "timeout_sec": {"type": "number", "exclusiveMinimum": 0},
        "max_response_bytes": {"type": "integer", "minimum": 1},
        "batch_rows": {"type": "integer", "minimum": 1},
        "pagination": {"$ref": "#/$defs/httpPagination"},
        "json": {"$ref": "#/$defs/httpJson"},
        "xml": {"$ref": "#/$defs/httpXml"}
      }
    },
    "httpPagination": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "strategy": {"enum": ["none", "page_number"]},
        "page_parameter": {"type": "string", "minLength": 1},
        "size_parameter": {"type": "string", "minLength": 1},
        "page_size": {"type": "integer", "minimum": 1},
        "start_page": {"type": "integer", "minimum": 1},
        "max_pages": {"type": "integer", "minimum": 1}
      }
    },
    "httpXml": {
      "type": "object", "additionalProperties": false, "required": ["item_path"],
      "properties": {
        "item_path": {"type": "string", "minLength": 1},
        "total_count_path": {"type": "string", "minLength": 1},
        "result_code_path": {"type": "string", "minLength": 1},
        "result_message_path": {"type": "string", "minLength": 1},
        "success_codes": {"type": "array", "items": {"type": ["string", "number"]}}
      }
    },
    "httpJson": {
      "type": "object", "additionalProperties": false, "required": ["item_path"],
      "properties": {
        "item_path": {"type": "string", "minLength": 1},
        "total_count_path": {"type": "string", "minLength": 1}
      }
    },
    "loggingOutput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root_dir": {"type": "string", "minLength": 1},
        "file_name_rule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "logging": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "parquetWriter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {"type": "boolean"},
        "engine": {"type": "string", "enum": ["pyarrow", "fastparquet"]},
        "write_page_index": {"type": "boolean"},
        "write_statistics": {"type": "boolean"},
        "data_page_size": {"type": "integer", "minimum": 1},
        "max_rows_per_page": {"type": "integer", "minimum": 1},
        "use_dictionary": {"oneOf": [{"type": "boolean"}, {"type": "array", "items": {"type": "string"}}]}
      }
    },
    "physicalLayout": {
      "type": "object",
      "description": "게시 Parquet의 재사용 프로필과 row-group 결정 범위",
      "additionalProperties": false,
      "required": ["profile", "adaptation_scope", "row_group_rows"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "adaptation_scope": {"const": "generation_fixed"},
        "row_group_rows": {"oneOf": [{"const": "auto"}, {"type": "integer", "minimum": 1}]}
      }
    }
  }
}
