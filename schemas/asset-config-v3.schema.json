{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smoking-data.asset-config.v3",
  "title": "Smoking Data Asset Config v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["config"],
  "properties": {
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "scope"],
      "properties": {
        "schema_version": {"const": "smoking-data.asset-config.v3"},
        "scope": {"enum": ["common", "0101", "0102", "0103", "0201", "0301", "0401"]}
      }
    },
    "paths": {
      "type": "object",
      "description": "다른 path 키를 재귀적으로 참조할 수 있는 경로 템플릿",
      "properties": {
        "data_root": {"type": "string", "description": "게시 dataset 최상위 경로"},
        "temp_root": {"type": "string", "description": "임시 runtime 경로"},
        "metadata_root": {"type": "string", "description": "공통 metadata 경로"},
        "log_root": {"type": "string", "description": "실행 log 경로"},
        "schedule_root": {"type": "string", "description": "Schedule YAML 디렉터리"}
      },
      "additionalProperties": {"type": "string"}
    },
    "execution": {
      "type": "object",
      "description": "공통 또는 Asset별 런타임 설정. process-wide memory는 scope=common에서만 선언한다.",
      "properties": {
        "memory": {
          "type": "object",
          "description": "scope=common 전용 process-wide memory envelope",
          "additionalProperties": false,
          "properties": {
            "hard_limit_mb": {"type": "integer", "minimum": 1},
            "safety_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "phases": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "build_sidecar": {"$ref": "#/$defs/phaseWorkers"},
                "materialize": {"$ref": "#/$defs/phaseWorkers"},
                "save_dataset": {"$ref": "#/$defs/phaseWorkers"}
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "contract": {
      "type": "object",
      "description": "Asset 실행 전반이 공유하는 불변 규칙",
      "additionalProperties": false,
      "properties": {
        "partition_grid": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "anchor_date": {"type": "string", "format": "date"},
            "step_days": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "output": {
      "type": "object",
      "description": "Asset Definition에 바로 병합되는 output 기본값"
    }
  },
  "$defs": {
    "phaseWorkers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workers"],
      "properties": {
        "workers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": {"type": "integer", "minimum": 1},
            "max": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
