{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "publication-v1.schema.json",
  "title": "smoking-data immutable object-store publication",
  "$defs": {
    "publicationOverride": {
      "type": "object",
      "description": "Asset Definition opts in with target and may add dataset-specific representation settings; shared policy comes from common config.",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "parquet": {"$ref": "#/$defs/publication/properties/parquet"},
        "sbdf": {"$ref": "#/$defs/publication/properties/sbdf"}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "target", "dataset_prefix"],
      "properties": {
        "enabled": {"type": "boolean"},
        "target": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "dataset_prefix": {"type": "string", "minLength": 1, "not": {"pattern": "(^|/)(\\.\\.?)(/|$)|^[\\\\/]|://"}},
        "mode": {"const": "mirror_after_local_commit"},
        "failure_policy": {"enum": ["required", "warn_and_retry"]},
        "parquet": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "random_access_index": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "level": {"enum": ["row_group", "page_if_available", "page_required", "key"]},
                "writer_page_index": {"oneOf": [{"type": "boolean"}, {"enum": ["enabled", "disabled"]}]},
                "key_columns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "planning_columns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "key_null_policy": {"enum": ["error", "skip"]},
                "key_hash": {"const": "sha256_trunc128_v1"},
                "hash_buckets": {"enum": [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536]}
              }
            }
          }
        },
        "sbdf": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "shard_policy": {"const": "mirror_parquet_parts"},
            "row_key_columns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "batch_size": {"type": "integer", "minimum": 1},
            "encoding_rle": {"type": "boolean"},
            "key_hash": {"const": "sha256_trunc128_v1"},
            "hash_buckets": {"enum": [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536]}
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checksum": {"const": "sha256"},
            "verify_remote_head": {"type": "boolean"},
            "verify_sidecar_references": {"type": "boolean"}
          }
        }
      }
    }
  }
}
