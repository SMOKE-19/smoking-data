{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smoking-data.csv-source.v1",
  "title": "Smoking Data 0103 CSV Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["yaml", "job", "source", "materialize", "routing", "output"],
  "properties": {
    "yaml": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "asset_code"],
      "properties": {
        "schema_version": {"const": "smoking-data.csv-source.v1"},
        "asset_code": {"const": "0103"}
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["csv", "source_file"],
      "anyOf": [
        {"required": ["directory"]},
        {"required": ["transport", "download"], "properties": {"transport": {"const": "http_download"}}}
      ],
      "properties": {
        "transport": {"enum": ["directory", "http_download"], "default": "directory"},
        "directory": {"type": "string", "minLength": 1},
        "download": {"$ref": "#/$defs/httpDownload"},
        "glob": {"type": "string", "minLength": 1, "default": "*.csv"},
        "recursive": {"type": "boolean", "default": true},
        "ordering": {"const": "path_asc"},
        "empty_directory_policy": {"const": "error"},
        "csv": {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "delimiter", "quote_char", "header", "malformed_row_policy"],
          "properties": {
            "encoding": {"type": "string", "minLength": 1},
            "delimiter": {"type": "string", "minLength": 1, "maxLength": 1},
            "quote_char": {"type": "string", "minLength": 1, "maxLength": 1},
            "header": {"type": "boolean"},
            "column_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "null_values": {"type": "array", "items": {"type": "string"}},
            "malformed_row_policy": {"const": "error"}
          }
        },
        "source_file": {
          "type": "object",
          "additionalProperties": false,
          "required": ["output_column", "value", "dtype", "existing_column_policy"],
          "properties": {
            "output_column": {"type": "string", "minLength": 1},
            "value": {"const": "relative_path"},
            "dtype": {"const": "STRING"},
            "existing_column_policy": {"const": "replace_with_warning"}
          }
        }
      }
    },
    "materialize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations"],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/operation"}
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "routes", "overlap_policy", "unmatched_policy"],
      "properties": {
        "input": {"type": "string", "minLength": 1},
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["route_name", "filtering"],
            "properties": {
              "route_name": {"type": "string", "minLength": 1},
              "filtering": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/expression"}
              }
            }
          }
        },
        "overlap_policy": {"const": "duplicate"},
        "unmatched_policy": {"const": "drop"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {"const": "source_dataset"},
            "root_dir": {"type": "string", "minLength": 1},
            "format": {"const": "parquet"},
            "compression": {"enum": ["zstd", "snappy", "uncompressed"]},
            "physical_layout": {"$ref": "#/$defs/physicalLayout"},
            "file_name_rule": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dataset", "parquet", "relative_path_token"],
              "properties": {
                "dataset": {"type": "string", "minLength": 1},
                "parquet": {"type": "string", "minLength": 1},
                "relative_path_token": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["posix_separator_replacement", "windows_separator_replacement", "collision_hash_length"],
                  "properties": {
                    "posix_separator_replacement": {"type": "string", "minLength": 1, "maxLength": 1},
                    "windows_separator_replacement": {"type": "string", "minLength": 1, "maxLength": 1},
                    "collision_hash_length": {"type": "integer", "minimum": 4, "maximum": 64}
                  }
                }
              }
            },
            "publication": {"$ref": "publication-v1.schema.json#/$defs/publicationOverride"}
          }
        },
        "logging": {"type": "object"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": true,
      "properties": {"target_rows_per_part": {"type": "integer", "minimum": 1}}
    }
  },
  "$defs": {
    "physicalLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "adaptation_scope", "row_group_rows"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "adaptation_scope": {"const": "generation_fixed"},
        "row_group_rows": {"oneOf": [{"const": "auto"}, {"type": "integer", "minimum": 1}]}
      }
    },
    "httpDownload": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [{"required": ["url"]}, {"required": ["discovery"]}],
      "properties": {
        "url": {"type": "string", "pattern": "^https?://"},
        "discovery": {"$ref": "#/$defs/gdeltDiscovery"},
        "query": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "headers": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "timeout_sec": {"type": "number", "exclusiveMinimum": 0},
        "format": {"enum": ["auto", "dsv", "zip"]},
        "file_name": {"type": "string", "minLength": 1},
        "max_download_bytes": {"type": "integer", "minimum": 1},
        "max_archive_members": {"type": "integer", "minimum": 1},
        "max_extracted_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "gdeltDiscovery": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "url", "file_kind", "selection"],
      "properties": {
        "type": {"const": "gdelt_v2_masterfile"},
        "url": {"type": "string", "pattern": "^https?://"},
        "file_kind": {"enum": ["events", "mentions", "gkg"]},
        "selection": {"const": "latest"},
        "stability_lag_minutes": {"type": "integer", "minimum": 0, "maximum": 60, "default": 0}
      }
    },
    "typeName": {"enum": ["STRING", "TEXT", "INT", "INT8", "INT16", "INT32", "INT64", "INTEGER", "FLOAT", "FLOAT32", "FLOAT64", "DOUBLE", "BOOL", "BOOLEAN", "DATE", "TIME", "DATETIME", "DURATION"]},
    "names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sql": {"type": "string", "minLength": 1},
        "spotfire_expression": {"type": "string", "minLength": 1}
      },
      "oneOf": [{"required": ["sql"]}, {"required": ["spotfire_expression"]}]
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "alias", "load_as", "columns_by_type", "default_type", "cast_failure_policy", "missing_named_column_policy"],
          "properties": {
            "op": {"const": "type_cast"},
            "alias": {"type": "string", "minLength": 1},
            "load_as": {"const": "STRING"},
            "columns_by_type": {"type": "object", "additionalProperties": {"$ref": "#/$defs/names"}},
            "default_type": {"$ref": "#/$defs/typeName"},
            "cast_failure_policy": {"const": "error"},
            "missing_named_column_policy": {"const": "error"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "alias", "id_columns", "value_columns", "name_column", "value_column", "value_type", "preserve_nulls"],
          "properties": {
            "op": {"const": "unpivot"},
            "alias": {"type": "string", "minLength": 1},
            "id_columns": {"$ref": "#/$defs/names"},
            "value_columns": {"const": "remaining"},
            "name_column": {"type": "string", "minLength": 1},
            "value_column": {"type": "string", "minLength": 1},
            "value_type": {"$ref": "#/$defs/typeName"},
            "preserve_nulls": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "alias", "expressions"],
          "properties": {
            "op": {"const": "add_calc"},
            "alias": {"type": "string", "minLength": 1},
            "expressions": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/expression"}
            }
          }
        }
      ]
    }
  }
}
