  "Smoking Data Template · 0201.pipeline_curated_pivot.0201.yaml · Slim": {
    "scope": "yaml",
    "prefix": "sd-template-0201-pipeline-curated-pivot",
    "description": "0201.pipeline_curated_pivot.0201.yaml Slim 예시",
    "body": [
      "yaml:",
      "  schema_version: smoking-data.pipeline.v7",
      "  asset_code: \"0201\"",
      "",
      "job:",
      "  name: curated_pivot",
      "",
      "output: {}",
      "define_upstream:",
      "- op: define_asset",
      "  alias: main",
      "  definition: 0101.source.0101.yaml",
      "# 외부 dataset을 작업 대상으로 지정하려면 위 define_asset 블록을 주석 처리하고 아래를 활성화한다.",
      "# - op: define_dataset",
      "#   alias: main",
      "#   paths: [DATA/input/curated]",
      "#   format: parquet",
      "#   union_by_name: true",
      "#   missing_columns: insert_null",
      "#   incompatible_dtypes: error",
      "",
      "build_sidecar:",
      "  alias: select_latest",
      "  source: main",
      "  columns: auto",
      "  operations:",
      "  - op: filter",
      "    alias: filter_valid_partition",
      "    spotfire_expression: '[partition] Is Not Null'",
      "  - op: add_calc",
      "    alias: calculate_selector_key",
      "    expressions:",
      "    - name: row_key.normalized",
      "      spotfire_expression: String([row_key])",
      "  - op: active_row_selection",
      "    method: sort_first",
      "    group_keys:",
      "    - name: partition",
      "      column: partition",
      "    - name: row_key.normalized",
      "      column: row_key.normalized",
      "    sort:",
      "    - column: updated_at",
      "      direction: desc",
      "      nulls: last",
      "",
      "materialize:",
      "  alias: materialize_selected_payload",
      "  source: main",
      "  coordinates: select_latest",
      "  partition_by: [partition]",
      "  part_boundary:",
      "    target_rows: 20000",
      "    preserve_groups: [partition, row_key.normalized, row_key]",
      "  workers: 1",
      "  max_tasks_per_child: 1",
      "  operations:",
      "  - op: type_cast",
      "    alias: cast_amount",
      "    columns:",
      "    - name: amount",
      "      type: INT64",
      "  - op: add_calc",
      "    alias: calculate_payload",
      "    expressions:",
      "    - name: amount.x2",
      "      sql: amount * 2",
      "    - name: amount_label",
      "      spotfire_expression: 'String([amount]) & \"_units\"'",
      "  - op: include_columns",
      "    alias: select_output_payload",
      "    columns:",
      "    - partition",
      "    - row_key",
      "    - updated_at",
      "    - metric",
      "    - amount",
      "    - amount.x2",
      "    - amount_label",
      "  - op: pivot",
      "    alias: pivot_metrics",
      "    row_keys: [partition, row_key]",
      "    column_keys: [metric]",
      "    value_keys:",
      "    - name: amount",
      "      source_column: amount",
      "      aggregation: first",
      "      column_name_rule: <column_key_value>__<value_key_name>",
      "    value_keys_without_column:",
      "    - name: latest_updated_at",
      "      source_column: updated_at",
      "      aggregation: max",
      "      column_name_rule: <value_key_name>.<agg>",
      "    first_duplicate_policy: error",
      "    null_column_key_policy: error",
      "    column_key_separator: __",
      "",
      "save_dataset:",
      "  alias: write_curated",
      "  input: materialize_selected_payload",
      "  partition_by: [partition]",
      "  operations: []",
      "$0"
    ]
  },
