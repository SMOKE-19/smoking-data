  "Smoking Data Template · 0201.gdelt_event_truth.0201.yaml · Slim": {
    "scope": "yaml",
    "prefix": "sd-template-0201-gdelt-event-truth",
    "description": "0201.gdelt_event_truth.0201.yaml Slim 예시",
    "body": [
      "yaml:",
      "  schema_version: smoking-data.pipeline.v7",
      "  asset_code: \"0201\"",
      "job:",
      "  name: gdelt_event_truth",
      "output: {}",
      "define_upstream:",
      "- op: define_asset",
      "  alias: main",
      "  definition: 0103.gdelt_latest_events.0103.yaml",
      "build_sidecar:",
      "  alias: select_latest_metric",
      "  source: main",
      "  partition_by: [partition]",
      "  part_boundary:",
      "    target_rows: 20000",
      "    preserve_groups: [partition, row_key, category]",
      "  columns: auto",
      "  operations:",
      "  - op: filter",
      "    alias: valid_key",
      "    sql: \"row_key IS NOT NULL AND partition IS NOT NULL\"",
      "  - op: active_row_selection",
      "    method: sort_first",
      "    group_keys:",
      "    - {name: partition, column: partition}",
      "    - {name: row_key, column: row_key}",
      "    - {name: category, column: category}",
      "    sort:",
      "    - {column: updated_at, direction: desc, nulls: last}",
      "materialize:",
      "  alias: materialize_truth",
      "  workers: 1",
      "  max_tasks_per_child: 1",
      "  operations:",
      "  - op: type_cast",
      "    alias: cast_metric_value",
      "    columns:",
      "    - {name: value, type: FLOAT64}",
      "  - op: include_columns",
      "    alias: truth_columns",
      "    columns: [partition, row_key, join_key, updated_at, category, value, SOURCEURL, file_name]",
      "$0"
    ]
  },
