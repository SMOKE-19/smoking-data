{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smoking-data.pipeline.v8",
  "title": "Smoking Data 0401 Single Snapshot Pipeline v8",
  "type": "object",
  "additionalProperties": false,
  "required": ["yaml", "job", "define_upstream", "build_sidecar", "materialize", "output"],
  "properties": {
    "yaml": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "asset_code"],
      "properties": {
        "schema_version": {"const": "smoking-data.pipeline.v8"},
        "asset_code": {"const": "0401"}
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"type": "string", "minLength": 1}}
    },
    "define_upstream": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/upstream"}
    },
    "build_sidecar": {"$ref": "#/$defs/buildSidecar"},
    "materialize": {"$ref": "#/$defs/materialize"},
    "output": {"$ref": "#/$defs/output"},
    "execution": {"$ref": "#/$defs/execution"}
  },
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "alias"],
      "properties": {
        "op": {"enum": ["define_asset", "define_dataset"]},
        "alias": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "paths": {"$ref": "#/$defs/stringArray"},
        "format": {"const": "parquet"},
        "union_by_name": {"const": true},
        "missing_columns": {"const": "insert_null"},
        "incompatible_dtypes": {"const": "error"}
      },
      "allOf": [
        {"if": {"properties": {"op": {"const": "define_asset"}}}, "then": {"required": ["definition"], "not": {"required": ["paths"]}}},
        {"if": {"properties": {"op": {"const": "define_dataset"}}}, "then": {"required": ["paths"], "not": {"required": ["definition"]}}}
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["op"],
      "properties": {
        "op": {"enum": ["filter", "type_cast", "add_calc", "reference_replace", "list_restore", "include_columns", "exclude_columns", "rename_columns", "unpivot", "unnest", "pivot"]},
        "alias": {"type": "string", "minLength": 1}
      },
      "not": {
        "anyOf": [
          {"required": ["inputs"]},
          {"required": ["partition_by"]}
        ]
      }
    },
    "buildSidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "source", "part_boundary"],
      "properties": {
        "alias": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "columns": {},
        "part_boundary": {"$ref": "#/$defs/partBoundary"},
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workers": {"type": "integer", "minimum": 1},
            "worker_recycle": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {"const": "adaptive"},
                "max_source_files": {"type": "integer", "minimum": 1},
                "max_projected_bytes_mb": {"type": "integer", "minimum": 1}
              }
            }
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "allOf": [
              {"$ref": "#/$defs/operation"},
              {"properties": {"op": {"enum": ["filter", "type_cast", "add_calc"]}}}
            ]
          }
        }
      },
      "not": {"required": ["partition_by"]}
    },
    "partBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_rows"],
      "properties": {
        "target_rows": {"type": "integer", "minimum": 1},
        "target_key_groups": {"type": "integer", "minimum": 1},
        "preserve_groups": {"$ref": "#/$defs/stringArray"}
      }
    },
    "materialize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "operations"],
      "properties": {
        "alias": {"type": "string", "minLength": 1},
        "workers": {"type": "integer", "minimum": 1},
        "max_tasks_per_child": {"type": "integer", "minimum": 1},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}}
      }
    },
    "physicalLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "adaptation_scope", "row_group_rows"],
      "properties": {
        "profile": {"const": "analysis_snapshot_adaptive_v1"},
        "adaptation_scope": {"enum": ["task_adaptive", "generation_fixed"]},
        "row_group_rows": {
          "oneOf": [{"const": "auto"}, {"type": "integer", "minimum": 1}]
        }
      }
    },
    "sbdfArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_key_columns"],
      "properties": {
        "row_key_columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "batch_size": {"type": "integer", "minimum": 1},
        "encoding_rle": {"type": "boolean"}
      }
    },
    "snapshotPublication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "target", "dataset_prefix", "parquet", "sbdf"],
      "properties": {
        "enabled": {"type": "boolean"},
        "target": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "dataset_prefix": {"type": "string", "minLength": 1, "not": {"pattern": "(^|/)(\\.\\.?)(/|$)|^[\\\\/]|://"}},
        "mode": {"const": "mirror_after_local_commit"},
        "failure_policy": {"enum": ["required", "warn_and_retry"]},
        "parquet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {"enabled": {"const": false}}
        },
        "sbdf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {"enabled": {"const": true}}
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checksum": {"const": "sha256"},
            "verify_remote_head": {"type": "boolean"},
            "verify_sidecar_references": {"type": "boolean"}
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "logging"],
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "root_dir", "format", "physical_layout"],
          "properties": {
            "type": {"const": "analysis_snapshot"},
            "root_dir": {"type": "string", "minLength": 1},
            "format": {"enum": ["sbdf", "parquet"]},
            "compression": {"enum": ["snappy", "zstd", "uncompressed"]},
            "physical_layout": {"$ref": "#/$defs/physicalLayout"},
            "sbdf": {"$ref": "#/$defs/sbdfArtifact"},
            "publication": {"$ref": "#/$defs/snapshotPublication"}
          }
        },
        "logging": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root_dir"],
          "properties": {"root_dir": {"type": "string", "minLength": 1}}
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workers": {"type": "integer", "minimum": 1},
        "max_tasks_per_child": {"type": ["integer", "null"], "minimum": 1},
        "target_rows_per_part": {"type": "integer", "minimum": 1},
        "target_key_groups_per_part": {"type": "integer", "minimum": 1},
        "max_source_files_per_task": {"type": "integer", "minimum": 1},
        "max_source_row_groups_per_task": {"type": "integer", "minimum": 1},
        "reset_before_run": {"type": "boolean"},
        "test_run": {
          "type": "object",
          "additionalProperties": false,
          "required": ["final_task_limit"],
          "properties": {"final_task_limit": {"type": "integer", "minimum": 1}}
        }
      }
    }
  }
}
