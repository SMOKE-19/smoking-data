{
  "yaml.schemas": {
    "./.vscode/schemas/asset-config-v3.schema.json": [
      "**/.smoking-data/config.yaml",
      "**/.smoking-data/assets/*/config.yaml"
    ],
    "./.vscode/schemas/pipeline-v6.schema.json": [
      "**/*.0301.yaml",
      "**/*.0301.yml"
    ],
    "./.vscode/schemas/pipeline-v7.schema.json": [
      "**/*.0201.yaml",
      "**/*.0201.yml"
    ],
    "./.vscode/schemas/pipeline-v8.schema.json": [
      "**/*.0401.yaml",
      "**/*.0401.yml"
    ],
    "./.vscode/schemas/calculated-fact-v2.schema.json": [
      "**/*.0102.yaml",
      "**/*.0102.yml"
    ],
    "./.vscode/schemas/asset-chain-v2.schema.json": [
      "**/*.chain.yaml",
      "**/*.chain.yml",
      "**/chain.*.yaml",
      "**/chain.*.yml"
    ],
    "./.vscode/schemas/schedule-v1.schema.json": [
      "**/*.schedule.yaml",
      "**/*.schedule.yml"
    ],
    "./.vscode/schemas/layout-migration-v1.schema.json": [
      "**/*.layout-migration.yaml",
      "**/*.layout-migration.yml"
    ],
    "./.vscode/schemas/physical-layout-recommendation-v2.schema.json": [
      "**/*.layout-recommendation.yaml",
      "**/*.layout-recommendation.yml"
    ],
    "./.vscode/schemas/source-0101.schema.json": [
      "**/*.0101.yaml",
      "**/*.0101.yml"
    ],
    "./.vscode/schemas/csv-source-v1.schema.json": [
      "**/*.0103.yaml",
      "**/*.0103.yml"
    ]
  },
  "yaml.yamlVersion": "1.2",
  "[yaml]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.tabCompletion": "on",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.formatOnSave": false
  }
}
