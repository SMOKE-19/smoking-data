  "Smoking Data Template · 0102.calculated_list_facts.0102.yaml · Slim": {
    "scope": "yaml",
    "prefix": "sd-template-0102-calculated-list-facts",
    "description": "0102.calculated_list_facts.0102.yaml Slim 예시",
    "body": [
      "yaml:",
      "  schema_version: smoking-data.calculated-fact.v2",
      "  asset_code: \"0102\"",
      "",
      "job:",
      "  name: calculated_list_facts",
      "",
      "output: {}",
      "define_upstream:",
      "- op: define_asset",
      "  alias: upstream",
      "  definition: 0301.pipeline_basic.0301.yaml",
      "",
      "build_sidecar:",
      "  alias: select_calculation_targets",
      "  source: upstream",
      "  # receipt/manifest에서 신규·SHA-256 변경 source segment만 고른다.",
      "  # upstream에서 사라진 segment의 과거 FACT는 삭제하거나 tombstone 처리하지 않는다.",
      "  # downstream materialize 계산식 의존성을 분석해 identity와 실제 참조 칼럼만 투영한다.",
      "  operations:",
      "  - op: incremental_fact_selection",
      "    alias: select_changed_facts",
      "    identity_columns: [partition, row_key]",
      "  execution:",
      "    workers: 1",
      "    worker_recycle:",
      "      max_source_files: 16",
      "      max_projected_bytes_mb: 512",
      "",
      "materialize:",
      "  alias: materialize_calculated_facts",
      "  source: upstream",
      "  coordinates: select_calculation_targets",
      "  partition_by: [partition]",
      "  part_boundary:",
      "    target_rows: 20000",
      "    preserve_groups: [partition, row_key]",
      "  workers: 1",
      "  max_tasks_per_child: 1",
      "  operations:",
      "  # List 계산이 없거나 planner가 list-native 실행을 선택할 수 있으면",
      "  # expand/compact 두 operation은 함께 생략할 수 있다.",
      "  - op: expand_list_rows",
      "    alias: expand_measurement_lists",
      "    columns:",
      "    - source: measured_values",
      "      element_alias: measured_value",
      "",
      "  - op: add_calc_cols_from_file",
      "    alias: calculate_from_spotfire",
      "    expression_file:",
      "      path: resources/0102/list_expressions.csv",
      "      column_name_field: Column Name",
      "      expression_field: Spotfire Expression",
      "    lookup_files: []",
      "    column_alias_files: []",
      "",
      "  - op: compact_list_rows",
      "    alias: compact_calculated_lists",
      "    expansion: expand_measurement_lists",
      "    columns:",
      "    - source: adjusted_value",
      "      output: adjusted_values",
      "",
      "  - op: unpivot_0102",
      "    alias: emit_calculated_facts",
      "    contract: long_fact_v1",
      "    # add_calc_cols_from_file이 생성한 계산 결과만 long fact로 내린다.",
      "    columns: calculated",
      "",
      "save_dataset:",
      "  alias: append_calculated_facts",
      "  input: materialize_calculated_facts",
      "  partition_by: [partition]",
      "  operations: []",
      "$0"
    ]
  },
