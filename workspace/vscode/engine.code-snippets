      "# 관리형 upstream이면 위 define_dataset을 주석 처리하고 아래를 활성화한다.",
      "# - op: define_asset",
      "#   alias: right_b",
      "#   definition: 0201.right_b.0201.yaml",
      "",
      "build_sidecar:",
      "  alias: join_keyspace",
      "  method: union_distinct_keys",
      "  sources: [left]",
      "  keys: [partition, join_key]",
      "  partition_by: [partition]",
      "  part_boundary:",
      "    target_rows: 20000",
      "    target_key_groups: 500",
      "    preserve_groups: [partition, join_key]",
      "",
      "materialize:",
      "  alias: materialize_left_parts",
      "  workers: 1",
      "  max_tasks_per_child: 4",
      "  operations:",
      "",
      "  - op: join",
      "    alias: join_left",
      "    input_right: left",
      "    left_on: [partition, join_key]",
      "    right_on: [partition, join_key]",
      "",
      "  - op: join",
      "    alias: join_right_a",
      "    input_right: right_a",
      "    left_on: [join_key]",
      "    right_on: [join_key_r]",
      "",
      "  - op: join",
      "    alias: join_right_b",
      "    input_right: right_b",
      "    left_on: [join_key]",
      "    right_on: [join_key_r]",
      "",
      "  - op: rename_columns",
      "    alias: rename_joined",
      "    inputs: {data: join_right_b}",
      "    mapping:",
      "      right_value: right_value_a",
      "",
      "  - op: include_columns",
      "    alias: select_join_output",
      "    inputs: {data: rename_joined}",
      "    columns:",
      "    - partition",
      "    - join_key",
      "    - right_value_a",
      "    - measure_a",
      "    - measure_b",
      "",
      "  - op: unpivot",
      "    alias: joined_unpivot",
      "    inputs: {data: select_join_output}",
      "    id_columns: [partition, join_key, right_value_a]",
      "    value_columns: [measure_a, measure_b]",
      "    name_column: metric_name",
      "    value_column: metric_value",
      "    coercion: strict",
      "    preserve_nulls: true",
      "",
      "  - op: data_assertion",
      "    alias: validate_join_output",
      "    inputs: {data: joined_unpivot}",
      "    rules:",
      "    - id: partition_required",
      "      kind: not_null",
      "      column: partition",
      "    - id: metric_name_required",
      "      kind: not_null",
      "      column: metric_name",
      "",
      "execution:",
      "  memory_budget_mb: 4096",
      "  max_source_files_per_task: 40",
      "  reset_before_run: false",
      "  # left/right index와 physical plan은 전체 입력으로 만들고 최종 join task만 제한한다.",
      "  # 같은 root_dir의 전체 결과를 부분 dataset으로 대체하므로 테스트 전용 경로 사용을 권장한다.",
