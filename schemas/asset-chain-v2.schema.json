{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smoking-data.asset-chain.v2",
  "title": "Smoking Data Asset Chain v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["yaml", "chain", "assets"],
  "properties": {
    "yaml": {
      "type": "object",
      "description": "YAML Definition 식별 정보",
      "additionalProperties": false,
      "required": ["schema_version"],
      "properties": {
        "schema_version": {"const": "smoking-data.asset-chain.v2", "description": "Asset Chain 공개 계약 버전"}
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"type": "string", "minLength": 1, "description": "Chain 실행과 metadata를 식별하는 이름"}}
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "asset_code", "definition"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "description": "Chain 안에서 유일한 Asset ID"},
          "asset_code": {"type": "string", "pattern": "^(01|03|04|05)[0-9]{2}$", "description": "산출물 계열과 variant를 나타내는 네 자리 코드"},
          "definition": {"type": "string", "minLength": 1, "description": "Chain YAML 기준 상대 Asset Definition 경로"},
          "inputs": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}, "description": "port 이름에서 upstream Asset ID로의 실행 의존관계"}
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failure_policy": {"const": "stop_downstream", "default": "stop_downstream"},
        "unchanged_policy": {"type": "string", "enum": ["skip", "run"], "default": "skip"},
        "max_parallel_assets": {"const": 1, "default": 1}
      }
    }
  }
}
