{
  "Smoking Data CSV Source 0103": {
    "scope": "yaml",
    "prefix": "sd-csv-source",
    "description": "0103 CSV directory → unpivot source_dataset Definition 골격",
    "body": [
      "yaml:",
      "  schema_version: smoking-data.csv-source.v1",
      "  asset_code: \"0103\"",
      "job:",
      "  id: ${1:csv-001}",
      "  name: ${2:csv_unpivot_source}",
      "source:",
      "  directory: ${3:DATA/input/csv}",
      "  glob: \"*.csv\"",
      "  recursive: true",
      "  ordering: path_asc",
      "  empty_directory_policy: error",
      "  csv: {encoding: utf8, delimiter: \",\", quote_char: '\"', header: true, malformed_row_policy: error}",
      "  source_file: {output_column: file_name, value: relative_path, dtype: STRING, existing_column_policy: replace_with_warning}",
      "materialize:",
      "  operations:",
      "  - op: type_cast",
      "    alias: typed_csv",
      "    load_as: STRING",
      "    columns_by_type:",
      "      STRING: [${4:row_key}]",
      "    default_type: ${5:FLOAT64}",
      "    cast_failure_policy: error",
      "    missing_named_column_policy: error",
      "  - op: unpivot",
      "    alias: unpivoted",
      "    id_columns: [${4}, file_name]",
      "    value_columns: remaining",
      "    name_column: category",
      "    value_column: value",
      "    value_type: ${5}",
      "    preserve_nulls: false",
      "routing:",
      "  input: unpivoted",
      "  routes:",
      "  - route_name: ${6:default}",
      "    filtering: [{sql: \"category IS NOT NULL\"}]",
      "  overlap_policy: duplicate",
      "  unmatched_policy: drop",
      "output: {}",
      "$0"
    ]
  }
}
