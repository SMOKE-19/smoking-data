{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smoking-data.local/schemas/calculated-fact-v4.schema.json",
  "title": "Smoking Data 0102 Calculated Fact",
  "type": "object",
  "additionalProperties": false,
  "required": ["yaml", "job", "output", "define_upstream", "build_sidecar", "materialize"],
  "properties": {
    "yaml": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "asset_code"],
      "properties": {
        "schema_version": {"const": "smoking-data.calculated-fact.v4"},
        "asset_code": {"const": "0102"}
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"$ref": "#/$defs/name"}}
    },
    "output": {"$ref": "#/$defs/output"},
    "define_upstream": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/defineAsset"}
    },
    "build_sidecar": {"$ref": "#/$defs/buildSidecar"},
    "materialize": {"$ref": "#/$defs/materialize"},
    "execution": {"$ref": "#/$defs/execution"}
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1},
    "positiveInteger": {"type": "integer", "minimum": 1},
    "names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "logging"],
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "root_dir", "format", "compression", "physical_layout"],
          "properties": {
            "type": {"const": "calculated_fact_dataset"},
            "root_dir": {"$ref": "#/$defs/name"},
            "format": {"const": "parquet"},
            "compression": {"const": "zstd"},
            "physical_layout": {"$ref": "#/$defs/physicalLayout"},
            "publication": {"$ref": "publication-v1.schema.json#/$defs/publicationOverride"}
          }
        },
        "logging": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root_dir"],
          "properties": {"root_dir": {"$ref": "#/$defs/name"}}
        }
      }
    },
    "defineAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "alias", "definition"],
      "properties": {
        "op": {"const": "define_asset"},
        "alias": {"$ref": "#/$defs/name"},
        "definition": {"$ref": "#/$defs/name"}
      }
    },
    "buildSidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "source", "identity_columns", "partition_by", "part_boundary"],
      "properties": {
        "alias": {"$ref": "#/$defs/name"},
        "source": {"$ref": "#/$defs/name"},
        "identity_columns": {"$ref": "#/$defs/names"},
        "partition_by": {"$ref": "#/$defs/names"},
        "part_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_rows", "preserve_groups"],
          "properties": {
            "target_rows": {"$ref": "#/$defs/positiveInteger"},
            "preserve_groups": {"$ref": "#/$defs/names"}
          }
        }
      }
    },
    "expandListRows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "alias", "columns"],
      "properties": {
        "op": {"const": "expand_list_rows"},
        "alias": {"$ref": "#/$defs/name"},
        "columns": {"$ref": "#/$defs/names"}
      }
    },
    "expressionFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "column_name_field", "expression_field"],
      "properties": {
        "path": {"$ref": "#/$defs/externalPath"},
        "column_name_field": {"$ref": "#/$defs/name"},
        "expression_field": {"$ref": "#/$defs/name"}
      }
    },
    "lookupFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "path", "source_keys", "lookup_keys"],
      "properties": {
        "alias": {"$ref": "#/$defs/name"},
        "path": {"$ref": "#/$defs/externalPath"},
        "source_keys": {"$ref": "#/$defs/names"},
        "lookup_keys": {"$ref": "#/$defs/names"}
      }
    },
    "columnAliasFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "path", "source_column_field", "alias_column_field"],
      "properties": {
        "alias": {"$ref": "#/$defs/name"},
        "path": {"$ref": "#/$defs/externalPath"},
        "source_column_field": {"$ref": "#/$defs/name"},
        "alias_column_field": {"$ref": "#/$defs/name"}
      }
    },
    "includeColumns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "alias", "columns"],
      "properties": {
        "op": {"const": "include_columns"},
        "alias": {"$ref": "#/$defs/name"},
        "columns": {"$ref": "#/$defs/names"}
      }
    },
    "referenceReplace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "alias", "files"],
      "properties": {
        "op": {"const": "reference_replace"},
        "alias": {"$ref": "#/$defs/name"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/columnAliasFile"}
        }
      }
    },
    "addCalculatedCols": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "alias", "expression_file"],
      "properties": {
        "op": {"const": "add_calculated_cols"},
        "alias": {"$ref": "#/$defs/name"},
        "expression_file": {"$ref": "#/$defs/expressionFile"},
        "lookup_files": {"type": "array", "items": {"$ref": "#/$defs/lookupFile"}}
      }
    },
    "compactListRows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "alias", "expansion_alias_list", "columns"],
      "properties": {
        "op": {"const": "compact_list_rows"},
        "alias": {"$ref": "#/$defs/name"},
        "expansion_alias_list": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/name"}
        },
        "columns": {"$ref": "#/$defs/names"}
      }
    },
    "unpivot0102": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "alias", "contract", "columns"],
      "properties": {
        "op": {"const": "unpivot_0102"},
        "alias": {"$ref": "#/$defs/name"},
        "contract": {"const": "long_fact_v1"},
        "columns": {"const": "calculated"}
      }
    },
    "materialize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "operations"],
      "properties": {
        "alias": {"$ref": "#/$defs/name"},
        "workers": {"$ref": "#/$defs/positiveInteger"},
        "max_tasks_per_child": {"const": 1},
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/includeColumns"},
              {"$ref": "#/$defs/referenceReplace"},
              {"$ref": "#/$defs/expandListRows"},
              {"$ref": "#/$defs/addCalculatedCols"},
              {"$ref": "#/$defs/compactListRows"},
              {"$ref": "#/$defs/unpivot0102"}
            ]
          }
        }
      }
    },
    "workerRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {"$ref": "#/$defs/positiveInteger"},
        "max": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "phaseMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workers"],
      "properties": {
        "workers": {"$ref": "#/$defs/workerRange"}
      }
    },
    "physicalLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "adaptation_scope", "row_group_rows"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "adaptation_scope": {"const": "generation_fixed"},
        "row_group_rows": {"oneOf": [{"const": "auto"}, {"type": "integer", "minimum": 1}]}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["phases"],
          "properties": {
            "phases": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "build_sidecar": {"$ref": "#/$defs/phaseMemory"},
                "materialize": {"$ref": "#/$defs/phaseMemory"}
              }
            }
          }
        },
        "max_source_files_per_task": {"$ref": "#/$defs/positiveInteger"},
        "reset_before_run": {"const": false}
      }
    },
    "externalPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\.([cC][sS][vV]|[pP][aA][rR][qQ][uU][eE][tT])$"
    }
  }
}
