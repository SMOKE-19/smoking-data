{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smoking-data.pipeline.v7",
  "title": "Smoking Data 0201 Phase Pipeline v7",
  "type": "object",
  "additionalProperties": false,
  "required": ["yaml", "job", "define_upstream", "build_sidecar", "materialize", "output"],
  "properties": {
    "yaml": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "asset_code"],
      "properties": {
        "schema_version": {"const": "smoking-data.pipeline.v7"},
        "asset_code": {"const": "0201"}
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"type": "string", "minLength": 1}}
    },
    "define_upstream": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/upstream"}
    },
    "combine_upstream": {"$ref": "#/$defs/combineUpstream"},
    "build_sidecar": {"$ref": "#/$defs/buildSidecar"},
    "materialize": {"$ref": "#/$defs/materialize"},
    "output": {"$ref": "#/$defs/output"},
    "execution": {"$ref": "#/$defs/execution"}
  },
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "phaseMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workers"],
      "properties": {
        "workers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": {"type": "integer", "minimum": 1},
            "max": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "alias"],
      "properties": {
        "op": {"enum": ["define_asset", "define_dataset"]},
        "alias": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "paths": {"$ref": "#/$defs/stringArray"},
        "format": {"const": "parquet"},
        "union_by_name": {"const": true},
        "missing_columns": {"const": "insert_null"},
        "incompatible_dtypes": {"const": "error"}
        ,"source_identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"value": {"type": "string", "minLength": 1}}
        },
        "select": {
          "type": "object",
          "additionalProperties": false,
          "required": ["labels"],
          "properties": {
            "labels": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"$ref": "#/$defs/stringArray"}
            }
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"op": {"const": "define_asset"}}}, "then": {"required": ["definition"], "not": {"required": ["paths"]}}},
        {"if": {"properties": {"op": {"const": "define_dataset"}}}, "then": {"required": ["paths"], "not": {"required": ["definition"]}}}
      ]
    },
    "combineUpstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "alias", "sources", "source_column"],
      "properties": {
        "op": {"const": "union_rows"},
        "alias": {"type": "string", "minLength": 1},
        "sources": {"$ref": "#/$defs/stringArray"},
        "source_column": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "dtype", "existing_column_policy"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "dtype": {"const": "STRING"},
            "existing_column_policy": {"const": "error"}
          }
        },
        "union_by_name": {"const": true},
        "missing_columns": {"const": "insert_null"},
        "incompatible_dtypes": {"const": "error"},
        "duplicate_path_policy": {"const": "error"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["op"],
      "properties": {
        "op": {"enum": ["filter", "type_cast", "add_calc", "active_row_selection", "reference_replace", "list_restore", "include_columns", "exclude_columns", "rename_columns", "unpivot", "pivot", "data_assertion"]},
        "alias": {"type": "string", "minLength": 1},
        "sql": {"type": "string"},
        "spotfire_expression": {"type": "string"},
        "columns": {},
        "expressions": {"type": "array", "items": {"type": "object"}},
        "method": {"type": "string"},
        "group_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "sort": {"type": "array", "items": {"type": "object"}}
      },
      "allOf": [
        {
          "if": {"properties": {"op": {"const": "filter"}}, "required": ["op"]},
          "then": {
            "oneOf": [
              {"required": ["sql"], "not": {"required": ["spotfire_expression"]}},
              {"required": ["spotfire_expression"], "not": {"required": ["sql"]}}
            ]
          }
        }
      ]
    },
    "buildSidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "source", "partition_by", "part_boundary", "operations"],
      "properties": {
        "alias": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "partition_by": {"$ref": "#/$defs/stringArray"},
        "part_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_rows"],
          "properties": {
            "target_rows": {"type": "integer", "minimum": 1},
            "target_key_groups": {"type": "integer", "minimum": 1},
            "preserve_groups": {"$ref": "#/$defs/stringArray"}
          }
        },
        "columns": {},
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workers": {"type": "integer", "minimum": 1},
            "worker_recycle": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {"const": "adaptive"},
                "max_source_files": {"type": "integer", "minimum": 1},
                "max_projected_bytes_mb": {"type": "integer", "minimum": 1}
              }
            }
          }
        },
        "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}}
      }
    },
    "materialize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "operations"],
      "properties": {
        "alias": {"type": "string", "minLength": 1},
        "workers": {"type": "integer", "minimum": 1},
        "max_tasks_per_child": {"type": "integer", "minimum": 1},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}}
      }
    },
    "publicationOverride": {
      "type": "object",
      "description": "0201 Definition은 게시 target만 선택하며 나머지 정책은 Asset config에서 상속한다.",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "logging"],
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "root_dir", "format", "compression", "physical_layout"],
          "properties": {
            "type": {"const": "curated_dataset"},
            "root_dir": {"type": "string", "minLength": 1},
            "format": {"const": "parquet"},
            "compression": {"enum": ["snappy", "zstd", "uncompressed"]},
            "physical_layout": {"$ref": "#/$defs/physicalLayout"},
            "publication": {"$ref": "#/$defs/publicationOverride"}
          }
        },
        "logging": {"type": "object", "additionalProperties": false, "required": ["root_dir"], "properties": {"root_dir": {"type": "string", "minLength": 1}}}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workers": {"type": "integer", "minimum": 1},
        "max_tasks_per_child": {"type": ["integer", "null"], "minimum": 1},
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["phases"],
          "properties": {
            "phases": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "build_sidecar": {"$ref": "#/$defs/phaseMemory"},
                "materialize": {"$ref": "#/$defs/phaseMemory"}
              }
            }
          }
        },
        "target_rows_per_part": {"type": "integer", "minimum": 1},
        "target_key_groups_per_part": {"type": "integer", "minimum": 1},
        "max_source_files_per_task": {"type": "integer", "minimum": 1},
        "max_source_row_groups_per_task": {"type": "integer", "minimum": 1},
        "reset_before_run": {"type": "boolean"},
        "test_run": {"type": "object", "additionalProperties": false, "required": ["final_task_limit"], "properties": {"final_task_limit": {"type": "integer", "minimum": 1}}}
      }
    },
    "physicalLayout": {
      "type": "object",
      "description": "게시 Parquet의 재사용 프로필과 row-group 결정 범위",
      "additionalProperties": false,
      "required": ["profile", "adaptation_scope", "row_group_rows"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "adaptation_scope": {"const": "generation_fixed"},
        "row_group_rows": {
          "description": "auto이면 planner가 세대 시작 시 결정하고, 정수이면 해당 행 수를 고정한다.",
          "oneOf": [{"const": "auto"}, {"type": "integer", "minimum": 1}]
        }
      }
    }
  }
}
