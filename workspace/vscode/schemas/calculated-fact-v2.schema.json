{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smoking-data.local/schemas/calculated-fact-v2.schema.json",
  "title": "Smoking Data 0102 Calculated Fact",
  "type": "object",
  "additionalProperties": false,
  "required": ["yaml", "job", "output", "define_upstream", "build_sidecar", "materialize", "save_dataset"],
  "properties": {
    "yaml": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "asset_code"],
      "properties": {
        "schema_version": {"const": "smoking-data.calculated-fact.v2"},
        "asset_code": {"const": "0102"}
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"$ref": "#/$defs/name"}}
    },
    "output": {"$ref": "#/$defs/output"},
    "define_upstream": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/defineAsset"}
    },
    "build_sidecar": {"$ref": "#/$defs/buildSidecar"},
    "materialize": {"$ref": "#/$defs/materialize"},
    "save_dataset": {"$ref": "#/$defs/saveDataset"},
    "execution": {"$ref": "#/$defs/execution"}
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1},
    "positiveInteger": {"type": "integer", "minimum": 1},
    "names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact"],
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "root_dir", "format", "compression", "write_policy"],
          "properties": {
            "type": {"const": "calculated_fact_dataset"},
            "root_dir": {"$ref": "#/$defs/name"},
            "format": {"const": "parquet"},
            "compression": {"const": "zstd"},
            "write_policy": {"const": "append_generation"},
            "physical_layout": {"type": "object"},
            "publication": {"$ref": "publication-v1.schema.json#/$defs/publication"}
          }
        },
        "logging": {"type": "object"}
      }
    },
    "defineAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "alias", "definition"],
      "properties": {
        "op": {"const": "define_asset"},
        "alias": {"$ref": "#/$defs/name"},
        "definition": {"$ref": "#/$defs/name"}
      }
    },
    "incrementalSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "alias", "identity_columns"],
      "properties": {
        "op": {"const": "incremental_fact_selection"},
        "alias": {"$ref": "#/$defs/name"},
        "identity_columns": {"$ref": "#/$defs/names"}
      }
    },
    "workerRecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_source_files": {"$ref": "#/$defs/positiveInteger"},
        "max_projected_bytes_mb": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "buildSidecarExecution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workers": {"const": 1},
        "worker_recycle": {"$ref": "#/$defs/workerRecycle"}
      }
    },
    "buildSidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "source", "operations"],
      "properties": {
        "alias": {"$ref": "#/$defs/name"},
        "source": {"$ref": "#/$defs/name"},
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/incrementalSelector"}
        },
        "execution": {"$ref": "#/$defs/buildSidecarExecution"}
      }
    },
    "listExpandColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "element_alias"],
      "properties": {
        "source": {"$ref": "#/$defs/name"},
        "element_alias": {"$ref": "#/$defs/name"}
      }
    },
    "expandListRows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "alias", "columns"],
      "properties": {
        "op": {"const": "expand_list_rows"},
        "alias": {"$ref": "#/$defs/name"},
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/listExpandColumn"}
        }
      }
    },
    "expressionFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "column_name_field", "expression_field"],
      "properties": {
        "path": {"$ref": "#/$defs/externalPath"},
        "column_name_field": {"$ref": "#/$defs/name"},
        "expression_field": {"$ref": "#/$defs/name"}
      }
    },
    "lookupFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "path", "source_keys", "lookup_keys"],
      "properties": {
        "alias": {"$ref": "#/$defs/name"},
        "path": {"$ref": "#/$defs/externalPath"},
        "source_keys": {"$ref": "#/$defs/names"},
        "lookup_keys": {"$ref": "#/$defs/names"}
      }
    },
    "columnAliasFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "path", "source_column_field", "alias_column_field"],
      "properties": {
        "alias": {"$ref": "#/$defs/name"},
        "path": {"$ref": "#/$defs/externalPath"},
        "source_column_field": {"$ref": "#/$defs/name"},
        "alias_column_field": {"$ref": "#/$defs/name"}
      }
    },
    "addCalcColsFromFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "alias", "expression_file"],
      "properties": {
        "op": {"const": "add_calc_cols_from_file"},
        "alias": {"$ref": "#/$defs/name"},
        "expression_file": {"$ref": "#/$defs/expressionFile"},
        "lookup_files": {"type": "array", "items": {"$ref": "#/$defs/lookupFile"}},
        "column_alias_files": {"type": "array", "items": {"$ref": "#/$defs/columnAliasFile"}}
      }
    },
    "listCompactColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "output"],
      "properties": {
        "source": {"$ref": "#/$defs/name"},
        "output": {"$ref": "#/$defs/name"}
      }
    },
    "compactListRows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "alias", "expansion", "columns"],
      "properties": {
        "op": {"const": "compact_list_rows"},
        "alias": {"$ref": "#/$defs/name"},
        "expansion": {"$ref": "#/$defs/name"},
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/listCompactColumn"}
        }
      }
    },
    "unpivot0102": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "alias", "contract", "columns"],
      "properties": {
        "op": {"const": "unpivot_0102"},
        "alias": {"$ref": "#/$defs/name"},
        "contract": {"const": "long_fact_v1"},
        "columns": {"const": "calculated"}
      }
    },
    "materialize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "source", "coordinates", "partition_by", "part_boundary", "operations"],
      "properties": {
        "alias": {"$ref": "#/$defs/name"},
        "source": {"$ref": "#/$defs/name"},
        "coordinates": {"$ref": "#/$defs/name"},
        "partition_by": {"$ref": "#/$defs/names"},
        "part_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_rows", "preserve_groups"],
          "properties": {
            "target_rows": {"$ref": "#/$defs/positiveInteger"},
            "preserve_groups": {"$ref": "#/$defs/names"}
          }
        },
        "workers": {"$ref": "#/$defs/positiveInteger"},
        "max_tasks_per_child": {"const": 1},
        "operations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/expandListRows"},
              {"$ref": "#/$defs/addCalcColsFromFile"},
              {"$ref": "#/$defs/compactListRows"},
              {"$ref": "#/$defs/unpivot0102"}
            ]
          }
        }
      }
    },
    "saveDataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "input", "partition_by"],
      "properties": {
        "alias": {"$ref": "#/$defs/name"},
        "input": {"$ref": "#/$defs/name"},
        "partition_by": {"$ref": "#/$defs/names"},
        "operations": {"type": "array", "maxItems": 0}
      }
    },
    "workerRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {"$ref": "#/$defs/positiveInteger"},
        "max": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "phaseMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_peak_memory_mb", "workers"],
      "properties": {
        "target_peak_memory_mb": {"$ref": "#/$defs/positiveInteger"},
        "workers": {"$ref": "#/$defs/workerRange"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hard_limit_mb", "safety_ratio", "phases"],
          "properties": {
            "hard_limit_mb": {"$ref": "#/$defs/positiveInteger"},
            "safety_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "phases": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "build_sidecar": {"$ref": "#/$defs/phaseMemory"},
                "materialize": {"$ref": "#/$defs/phaseMemory"},
                "save_dataset": {"$ref": "#/$defs/phaseMemory"}
              }
            }
          }
        },
        "max_source_files_per_task": {"$ref": "#/$defs/positiveInteger"},
        "reset_before_run": {"const": false}
      }
    },
    "externalPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\.([cC][sS][vV]|[pP][aA][rR][qQ][uU][eE][tT])$"
    }
  }
}
